// Cloudflare Workers config for the flowers page only (not the Tally app).
// Deployed by .github/workflows/deploy-flowers.yml, which stages
// public/flowers.html as .flowers-site/index.html before running wrangler.
{
  "name": "flowers",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./.flowers-site"
  },
  // Attaching the custom domain here means every deploy keeps the DNS
  // record and certificate in place automatically.
  "routes": [
    { "pattern": "babicean.com", "custom_domain": true },
    { "pattern": "flowers.babicean.com", "custom_domain": true }
  ]
}
